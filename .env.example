# Client-provided key — Tombstone must use only this key for every LLM call
# and for the Agent SDK's built-in web_search / web_fetch tools.
ANTHROPIC_API_KEY=

# Rolling tracking window, in days. 90 = "last three months".
TRACKING_WINDOW_DAYS=90

# Hard cost ceiling per run, in USD. The orchestrator stops issuing new
# agent calls once this is reached and finishes the run with what it has.
RUN_BUDGET_USD=15.00

# Verifier <-> Research bounce limit per deal.
MAX_VERIFICATION_ROUNDS=2
