# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment
.env

# Local run state — never committed, only snapshot_*.json and omissions.json are
data/cache.db
data/*.db

# Frontend
frontend/node_modules/
frontend/dist/
# Generated at build time by scripts/copy-data.mjs from data/ — the
# committed copies in data/ are the source of truth, not these.
frontend/public/data/
frontend/tsconfig.tsbuildinfo

# PyInstaller working directories. Tombstone.exe itself IS committed, at the
# repo root: the launcher starts the stack described by docker-compose.yml and
# finds it by walking up from its own location, so it only works from inside
# the project. Shipping it separately would be shipping something that cannot
# run. Rebuild it with `make launcher`.
build/
dist/
*.spec.bak

# OS / editor
.DS_Store
.vscode/
